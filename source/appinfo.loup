@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "xcopy";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Copy files and directory trees (a Loup recreation of the Windows xcopy command).";

# Exit statuses returned by main() (xcopy's ERRORLEVELs).
pub const EXIT_OK: int = 0;          # files were copied without error
pub const EXIT_NO_FILES: int = 1;    # no files were found to copy
pub const EXIT_ABORTED: int = 2;     # stopped at a prompt (Ctrl+C on Windows; end of input here)
pub const EXIT_INIT: int = 4;        # initialization error: syntax, missing source, cyclic copy...
pub const EXIT_WRITE: int = 5;       # a file or directory could not be written
