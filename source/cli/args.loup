@mode(host.dual)

# Command-line parsing for xcopy, with the shared Windows switch parser
# (win/switches.loup). `/Y` and `/-Y` can also come from the COPYCMD
# environment variable, which the command line overrides.
#
# Runtime: host.dual. Compiled into the native binary build/xcopy by `make
# build`; `loup run source/main.loup` interprets the same code. The caller
# reads COPYCMD and passes its value in, so parsing stays a pure function.

from win.switches import (SwitchArgs, SwitchSpec, flag, required_value, parse_switches, has_switch,
    switch_values);

pub const MSG_INVALID_PARAMETERS: string = "Invalid number of parameters";

# Overwrite modes.
pub const OVERWRITE_ASK: int = 0;    # /-Y (the default)
pub const OVERWRITE_ALL: int = 1;    # /Y

# Fields are `var` so that tests can adjust default_options().
pub struct Options {
    pub var help: bool;
    pub var version: bool;
    pub var subdirs: bool;            # /S
    pub var empty_dirs: bool;         # /E
    pub var assume_dir: bool;         # /I
    pub var overwrite: int;           # /Y, /-Y, COPYCMD
    pub var quiet: bool;              # /Q
    pub var full_names: bool;         # /F
    pub var list_only: bool;          # /L
    pub var tree_only: bool;          # /T
    pub var exclude_files: list[string];  # /EXCLUDE:file1+file2
    pub var keep_going: bool;         # /C
    pub var hidden: bool;             # /H
    pub var update_only: bool;        # /U
    pub var operands: list[string];
}

# Options with xcopy's defaults; for tests.
pub func default_options(operands: list[string]): Options {
    let none: list[string] = [];
    return Options(help = false, version = false, subdirs = false, empty_dirs = false,
        assume_dir = false, overwrite = OVERWRITE_ASK, quiet = false, full_names = false,
        list_only = false, tree_only = false, exclude_files = none, keep_going = false,
        hidden = false, update_only = false, operands = operands);
}

# The switches xcopy declares.
pub func xcopy_switches(): list[SwitchSpec] {
    return [
        flag("S"), flag("E"), flag("I"), flag("Y"), flag("-Y"), flag("Q"), flag("F"), flag("L"),
        flag("T"), flag("C"), flag("H"), flag("U"),
        required_value("EXCLUDE"),
    ];
}

# The overwrite mode that COPYCMD presets (`/Y` or `/-Y` in it; the last
# one counts), or `fallback`.
pub func copycmd_overwrite(copycmd: string, fallback: int): int {
    var mode = fallback;
    for (word in copycmd.split(" ")) {
        let w = word.toUpperCase();
        if (w == "/Y" or w == "-Y") {
            mode = OVERWRITE_ALL;
        } else if (w == "/-Y" or w == "--Y") {
            mode = OVERWRITE_ASK;
        }
    }
    return mode;
}

func overwrite_of(parsed: SwitchArgs, preset: int): int {
    var mode = preset;
    for (sw in parsed.switches) {
        if (sw.name == "Y") {
            mode = OVERWRITE_ALL;
        } else if (sw.name == "-Y") {
            mode = OVERWRITE_ASK;
        }
    }
    return mode;
}

# The exclusion files of every /EXCLUDE:a+b switch, in order.
func exclude_files_of(parsed: SwitchArgs): list[string] {
    var out: list[string] = [];
    for (value in switch_values(parsed, "EXCLUDE")) {
        for (name in value.split("+")) {
            if (name.len() > 0) {
                out.push(name);
            }
        }
    }
    return out;
}

# Parses the command line; `copycmd` is the value of the COPYCMD variable.
# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string], copycmd: string): Result[Options, string] {
    let parsed = match parse_switches(argv, xcopy_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err("Invalid switch - " + e.text);
        },
    };
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        subdirs = has_switch(parsed, "S") or has_switch(parsed, "E"),
        empty_dirs = has_switch(parsed, "E"),
        assume_dir = has_switch(parsed, "I"),
        overwrite = overwrite_of(parsed, copycmd_overwrite(copycmd, OVERWRITE_ASK)),
        quiet = has_switch(parsed, "Q"),
        full_names = has_switch(parsed, "F"),
        list_only = has_switch(parsed, "L"),
        tree_only = has_switch(parsed, "T"),
        exclude_files = exclude_files_of(parsed),
        keep_going = has_switch(parsed, "C"),
        hidden = has_switch(parsed, "H"),
        update_only = has_switch(parsed, "U"),
        operands = parsed.operands,
    ));
}

# The usage error for the operands, or "" when there are one or two. A
# third argument that looks like a switch is reported as one.
pub func operand_error(operands: list[string]): string {
    if (operands.len() == 0) {
        return MSG_INVALID_PARAMETERS;
    }
    if (operands.len() > 2) {
        for (k in 2..operands.len()) {
            let op = operands[k];
            if (op.len() > 1 and (op.startsWith("/") or op.startsWith("-"))) {
                return "Invalid switch - " + op;
            }
        }
        return MSG_INVALID_PARAMETERS;
    }
    return "";
}
