@mode(host.dual)

from appinfo import (EXIT_OK, EXIT_INIT);
from cli.args import (parse_args, operand_error);
from cli.usage import (usage, version_line);
from commands.xcopy import (run_xcopy, MSG_NONE_COPIED);

# Parses argv, runs xcopy and returns the exit status (xcopy's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv, env("COPYCMD") ?? "") {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            println(MSG_NONE_COPIED);
            return EXIT_INIT;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    let bad = operand_error(opts.operands);
    if (bad.len() > 0) {
        printErr(bad);
        println(MSG_NONE_COPIED);
        return EXIT_INIT;
    }

    try {
        return run_xcopy(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_INIT;
    }
}
