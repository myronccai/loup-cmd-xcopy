@mode(host.dual)

# xcopy: copies files and directory trees. run_xcopy plans the copy
# (commands/plan.loup), asks what it has to ask (destination kind,
# overwrites), then lists and copies each file and prints the count.
#
# io.fs never reports a failure in native builds (and throws in Stage0), so
# every directory creation and copy is checked afterwards.
#
# Runtime: host.dual. Compiled into the native binary build/xcopy by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: messages; the exceptions (XcopyError and its InitError,
# AbortError and WriteError, each with the ERRORLEVEL it ends the run
# with); ask, the prompt loop; make_dir and copy_file, which verify what
# they did; reading the /EXCLUDE files; copy_tree, the run: resolve and
# walk the source, settle the destination, plan the items, create the
# directories, then copy (or list) each file; and xcopy_with, which turns
# an exception that ends the run into its ERRORLEVEL.

from appinfo import (EXIT_OK, EXIT_NO_FILES, EXIT_ABORTED, EXIT_INIT, EXIT_WRITE);
from cli.args import (Options, OVERWRITE_ASK, OVERWRITE_ALL);
from io.fs import (copy, createDir, isDir, isFile);
from win.messages import (MSG_ACCESS_DENIED);
from win.paths import (display_path, fs_path, parent_dir, strip_trailing_separators);
from commands.answers import (Answers, stdin_answers, has_answer, take_answer);
from commands.fspaths import (current_dir, absolute_path, is_within, under);
from commands.plan import (Item, resolve_source, collect, destination_kind,
    plan_items, KIND_ASK, KIND_DIR, KIND_FILE);

pub const MSG_NONE_COPIED: string = "0 File(s) copied";
pub const MSG_CYCLIC: string = "Cannot perform a cyclic copy";
pub const MSG_ONTO_ITSELF: string = "File cannot be copied onto itself";

# The last line: `N File(s) copied`, or `N File(s)` with /L.
pub func count_line(n: int, list_only: bool): string {
    if (list_only) {
        return str(n) + " File(s)";
    }
    return str(n) + " File(s) copied";
}

pub func msg_cant_read(name: string): string {
    return "Can't read file: " + name;
}

pub func msg_file_or_dir(name: string): string {
    return "Does " + name + " specify a file name\nor directory name on the target\n(F = file, D = directory)? ";
}

pub func msg_overwrite(name: string): string {
    return "Overwrite " + name + " (Yes/No/All)? ";
}

pub func msg_unable_dir(name: string): string {
    return "Unable to create directory - " + name;
}

pub func msg_creation_error(reason: string): string {
    return "File creation error - " + reason;
}

# xcopy's failures, each carrying the ERRORLEVEL it ends the run with.
# They are declared in the only module that throws them: natively, a custom
# exception thrown from another module than its own is unreliable.
pub class XcopyError : Exception {
    pub let level: int;

    new(message: string, level: int) {
        super(message);
        this.level = level;
    }
}

# Nothing could be copied: a missing source, an unreadable /EXCLUDE file, a
# cyclic copy, ... (ERRORLEVEL 4).
pub class InitError : XcopyError {
    new(message: string) {
        super(message, EXIT_INIT);
    }
}

# The input ended at a prompt, as Ctrl+C would on Windows (ERRORLEVEL 2).
pub class AbortError : XcopyError {
    new() {
        super("", EXIT_ABORTED);
    }
}

# A file or directory could not be written (ERRORLEVEL 5).
pub class WriteError : XcopyError {
    new(message: string) {
        super(message, EXIT_WRITE);
    }
}

# Prints a prompt until the answer is one of `choices` (upper-case letters)
# and returns that letter. The answer is echoed, as the console would. The
# question is always shown once, hence do/while; when the input has ended
# it throws AbortError.
pub func ask(question: string, choices: string, edits answers: Answers): string {
    var up = "";
    do {
        print(question);
        if (!has_answer(edits: answers)) {
            println("");
            throw AbortError();
        }
        let answer = take_answer(edits: answers);
        println(answer);
        up = answer.toUpperCase();
    } while (up.len() == 0 or choices.index_of(up) < 0);
    return up;
}

# Creates a directory (and its parents); whether it exists afterwards.
pub func make_dir(path: string): bool {
    if (path.len() == 0 or isDir(path)) {
        return true;
    }
    try {
        createDir(path);
    } catch {
        return false;
    }
    return isDir(path);
}

# Copies one file, creating its directory, or throws WriteError with
# xcopy's message.
pub func copy_file(src: string, dst: string): void {
    let parent = parent_dir(dst);
    if (!make_dir(parent)) {
        throw WriteError(msg_unable_dir(display_path(parent)));
    }
    if (isDir(dst)) {
        throw WriteError(msg_creation_error(MSG_ACCESS_DENIED));
    }
    try {
        copy(src, dst);
    } catch (Exception as e) {
        # Stage0's io.fs throws; keep its error as the cause.
        throw WriteError(msg_creation_error(MSG_ACCESS_DENIED)) from e;
    }
    # Native io.fs fails silently: check the result.
    if (!isFile(dst)) {
        throw WriteError(msg_creation_error(MSG_ACCESS_DENIED));
    }
}

# Reads the /EXCLUDE files: their non-empty lines, upper case. A file that
# cannot be read ends the run.
func read_excludes(names: list[string]): list[string] {
    var out: list[string] = [];
    for (name in names) {
        let path = fs_path(name);
        if (!isFile(path)) {
            throw InitError(msg_cant_read(name));
        }
        for (line in readText(path).split("\n")) {
            let text = if (line.endsWith("\r")) { line.slice(0, line.len() - 1) } else { line };
            if (text.len() > 0) {
                out.push(text.toUpperCase());
            }
        }
    }
    return out;
}

# How a listed file is shown: as typed, or with /F as full source and
# destination paths.
func listing(item: Item, full_names: bool, cwd: string): string {
    if (!full_names) {
        return item.shown;
    }
    if (cwd.len() == 0) {
        return display_path(item.src) + " -> " + display_path(item.dst);
    }
    return display_path(absolute_path(item.src, cwd)) + " -> " + display_path(absolute_path(item.dst, cwd));
}

pub func run_xcopy(opts: Options): int {
    var answers = stdin_answers();
    return xcopy_with(opts, edits: answers);
}

# run_xcopy with the prompt answers given (tests pass answers_from(text)).
# An InitError prints its message and `0 File(s) copied`; an AbortError
# ends the run silently.
pub func xcopy_with(opts: Options, edits answers: Answers): int {
    try {
        return copy_tree(opts, edits: answers);
    } catch (InitError as e) {
        printErr(e.message);
        println(MSG_NONE_COPIED);
        return e.level;
    } catch (XcopyError as e) {
        return e.level;
    }
}

func copy_tree(opts: Options, edits answers: Answers): int {
    let source = resolve_source(opts.operands[0]);
    if (source.error.len() > 0) {
        throw InitError(source.error);
    }
    let excludes = read_excludes(opts.exclude_files);

    # Walk the source. A wildcard or file name that matched nothing ends the
    # run; a directory with nothing to copy does not.
    let cwd = current_dir();
    let recurse = opts.subdirs or opts.tree_only;
    let found = collect(source, recurse, opts.hidden, excludes, cwd);
    if (found.matched == 0 and source.wild) {
        throw InitError("File not found - " + source.pattern);
    }

    # Settle the destination: a directory or a file, asking when xcopy
    # cannot tell. Copying a tree into itself would never end.
    let dest_operand = if (opts.operands.len() > 1) { opts.operands[1] } else { "" };
    var kind = destination_kind(dest_operand, source, opts.assume_dir);
    if (kind == KIND_ASK) {
        let answer = ask(msg_file_or_dir(display_path(dest_operand)), "FD", edits: answers);
        kind = if (answer == "D") { KIND_DIR } else { KIND_FILE };
    }
    let dest = strip_trailing_separators(fs_path(dest_operand));
    let dest_is_dir = kind == KIND_DIR;
    if (recurse and dest_is_dir and cwd.len() > 0
        and is_within(absolute_path(dest, cwd), absolute_path(source.base, cwd))) {
        throw InitError(MSG_CYCLIC);
    }

    # The copy list, with /U applied. Any file onto itself stops the run
    # before anything is written.
    var items: list[Item] = [];
    for (item in plan_items(source, found.files, dest, dest_is_dir)) {
        if (cwd.len() > 0 and absolute_path(item.src, cwd) == absolute_path(item.dst, cwd)) {
            throw InitError(MSG_ONTO_ITSELF);
        }
        if (!opts.update_only or isFile(item.dst)) {
            items.push(item);
        }
    }

    # Directories: the destination, every walked directory with /E, and
    # with /T the ones that would hold files.
    var errors = 0;
    if (!opts.list_only and dest_is_dir) {
        var wanted: list[string] = [dest];
        if (opts.empty_dirs or opts.tree_only) {
            let rels = if (opts.empty_dirs) { found.dirs } else { found.file_dirs };
            for (rel in rels) {
                wanted.push(under(dest, rel));
            }
        }
        for (dir in wanted) {
            if (errors == 0 and !make_dir(dir)) {
                printErr(msg_unable_dir(display_path(dir)));
                errors += 1;
            }
        }
    }
    if (opts.tree_only or (errors > 0 and !opts.keep_going)) {
        println(MSG_NONE_COPIED);
        return if (errors > 0) { EXIT_WRITE } else { EXIT_OK };
    }

    # Copy (or with /L only list) each item. An `All` answer turns the
    # overwrite prompts off for the rest of the run; a WriteError is
    # reported and, without /C, ends the copying.
    var copied = 0;
    var overwrite = opts.overwrite;
    for (item in items) {
        if (!opts.list_only and overwrite == OVERWRITE_ASK and isFile(item.dst)) {
            let answer = ask(msg_overwrite(display_path(item.dst)), "YNA", edits: answers);
            if (answer == "N") {
                continue;
            }
            if (answer == "A") {
                overwrite = OVERWRITE_ALL;
            }
        }
        if (!opts.quiet) {
            println(listing(item, opts.full_names, cwd));
        }
        if (opts.list_only) {
            copied += 1;
            continue;
        }
        try {
            copy_file(item.src, item.dst);
            copied += 1;
        } catch (WriteError as e) {
            printErr(e.message);
            errors += 1;
            if (!opts.keep_going) {
                break;
            }
        }
    }
    println(count_line(copied, opts.list_only));
    if (errors > 0) {
        return EXIT_WRITE;
    }
    if (items.len() == 0) {
        return EXIT_NO_FILES;
    }
    return EXIT_OK;
}
